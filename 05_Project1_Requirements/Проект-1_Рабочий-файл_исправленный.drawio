        </mxCell>
        <mxCell id="fDcl3MHUkUBJmMv9Qxax-8" parent="1" style="swimlane;html=1;startSize=20;fontStyle=0;collapsible=0;horizontal=1;swimlaneLine=1;strokeWidth=2;swimlaneFillColor=#ffffff;whiteSpace=wrap;fontSize=15;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Контекстный&amp;nbsp;уровень" vertex="1">
          <mxGeometry height="280" width="1090" x="40" y="-1120" as="geometry" />
        </mxCell>
        <mxCell id="fDcl3MHUkUBJmMv9Qxax-9" edge="1" parent="fDcl3MHUkUBJmMv9Qxax-8" source="fDcl3MHUkUBJmMv9Qxax-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" target="fDcl3MHUkUBJmMv9Qxax-14">
