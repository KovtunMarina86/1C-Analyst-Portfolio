        </mxCell>
        <mxCell id="fDcl3MHUkUBJmMv9Qxax-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=20;align=center;verticalAlign=top;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;Элементы, доступные для добавления в диаграмму&amp;nbsp;&lt;/font&gt;" vertex="1">
